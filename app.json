{
  "expo": {
    "name": "ShiftPlan Converter",
    "slug": "shiftplan-converter",
    "version": "0.1.6",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "shiftplan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F1F5F9",
      "translucent": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fr4iser.shiftplan",
      "infoPlist": {
        "NSFaceIDUsageDescription": "ShiftPlan Converter kann Face ID nutzen, um Abrufen und Zugangsdaten zu schützen.",
        "NSCameraUsageDescription": "ShiftPlan Converter fotografiert den Dienstplan für die Erkennung direkt auf dem Gerät.",
        "NSPhotoLibraryUsageDescription": "ShiftPlan Converter liest ein Dienstplan-Foto für die Erkennung direkt auf dem Gerät.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "shiftplan"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.fr4iser.shiftplan",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0f766e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "shiftplan"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0f766e"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f766e"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "25b67596-d979-448a-bb56-ae871bf4902b"
      }
    }
  }
}
