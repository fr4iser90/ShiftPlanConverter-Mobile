  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "^58.0.11",
    "ts-jest": "^29.4.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "uuid": "^11.1.1"
  },
  "scripts": {
    "start": "expo start --port 8091",
    "start:emu": "bash scripts/dev/start-emu.sh",
    "stop": "bash scripts/dev/stop-metro.sh",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "npm run packs:generate && jest",
    "typecheck": "npm run packs:generate && tsc --noEmit",
    "packs:generate": "node scripts/packs/generate-registry.cjs",
    "smoke:gate": "bash tests/e2e/run-gate-debug.sh",
    "smoke:matrix": "bash tests/e2e/run-matrix.sh",
    "smoke:matrix:moto": "nix-shell --run \"python3 -u tests/e2e/live-smoke-matrix.py --profiles moto_g73 --months 07 --year 2026 --ticks 80\"",
    "lint": "expo lint || true",
    "release:check": "bash scripts/dev/release-security-check.sh",
    "eas:preview:android": "eas build --platform android --profile preview",
    "eas:preview:ios": "eas build --platform ios --profile preview",
    "eas:dev:android": "eas build --platform android --profile development"
  },
  "private": true
