{
  "engine": "pdf-payroll",
  "scoreHints": ["Abrechnungsmonat", "Zeitabrechnung", "KO*", "GE*", "Bereitschaft"],
  "monthHeader": {
    "pattern": "Abrechnungsmonat\\s+(\\d{2})/(\\d{4})",
    "monthGroup": 1,
    "yearGroup": 2
  },
  "mainSectionRestart": "Zeitabrechnung",
  "bereitschaftSection": "Bereitschaftsdienste",
  "shift": {
    "pattern": "^\\s*(\\d{2})\\s+\\S+\\s+KO\\*\\s+(\\d{2}:\\d{2})\\s+GE\\*\\s+(\\d{2}:\\d{2})(?:\\s+([\\d,]+)\\s+([\\d,]+)\\s+([\\d,]+)\\s+([\\d,]+)\\s+([+-]?[\\d,]+)\\s+([\\d,]+))?",
    "type": "WORK",
    "dayGroup": 1,
    "startGroup": 2,
    "endGroup": 3,
    "extra": {
      "pause": 4,
      "pepSoll": 5,
      "vertrSoll": 6,
      "ist": 7,
      "azkDaily": 8,
      "azkKum": 9
    }
  },
  "allDay": [
    {
      "pattern": "^\\s*(\\d{2})\\s+\\S+\\s+(URLTV|URLAUB)\\b",
      "dayGroup": 1,
      "type": "URLAUB"
    },
    {
      "pattern": "^\\s*(\\d{2})\\s+\\S+\\s+(KROAU|KRANK|KR)\\b",
      "dayGroup": 1,
      "typeFromGroup": 2,
      "normalize": { "KR": "KRANK" }
    },
    {
      "pattern": "^\\s*(\\d{2})\\s+\\S+\\s+FEIER",
      "dayGroup": 1,
      "type": "FEIERTAG"
    }
  ],
  "onCall": {
    "pattern": "^\\s*(\\d{2}\\.\\d{2}\\.\\d{4})\\s+.*?(\\d{2}:\\d{2})\\s+(\\d{2}:\\d{2}).*?(\\d+)\\s+(\\d+)\\s+([\\d,]+)\\s*$",
    "fallbackPattern": "^\\s*(\\d{2}\\.\\d{2}\\.\\d{4})\\s+.*?(\\d{2}:\\d{2})\\s+(\\d{2}:\\d{2})",
    "type": "BEREIT",
    "dateGroup": 1,
    "startGroup": 2,
    "endGroup": 3,
    "bereitPercentGroup": 5,
    "bewertetGroup": 6
  },
  "summary": [
    {
      "field": "uebertragVormonat",
      "pattern": "(?:Ü|Ue|U)bertrag\\s+aus\\s+Vormonat\\s+([+-]?[\\d,]+)",
      "group": 1
    },
    {
      "field": "uebertragFolgemonat",
      "pattern": "(?:Ü|Ue|U)bertrag\\s+in\\s+Folgemonat\\s+([+-]?[\\d,]+)",
      "group": 1
    },
    {
      "field": "periodeIst",
      "pattern": "Periode\\s*\\([^)]+\\)\\s+([\\d,]+)\\s+([\\d,]+)\\s+([\\d,]+)\\s+([+-]?[\\d,]+)",
      "groups": {
        "periodePepSoll": 1,
        "periodeVertrSoll": 2,
        "periodeIst": 3,
        "periodeSaldo": 4
      }
    },
    {
      "field": "bereitschaftAuszahlung",
      "pattern": "Bereitschaft\\s+zur\\s+Auszahlung\\s+([+-]?[\\d,]+)",
      "group": 1
    },
    {
      "field": "bereitschaftAzk",
      "pattern": "Bereitschaft\\s+in\\s+das\\s+AZK\\s+([+-]?[\\d,]+)",
      "group": 1
    }
  ]
}
